# =============================================================================
# MUS-DOWNLOADER CONFIGURATION (.env)
# Скопируйте этот файл в .env и укажите свои значения:
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. TELEGRAM BOT (Обязательно для запуска бота)
# -----------------------------------------------------------------------------
# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Белый список Telegram ID пользователей через запятую (узнать ID: @userinfobot)
# Если пусто, бот будет доступен только если список не проверяется (рекомендуется указать свой ID)
ALLOWED_USERS=123456789

# Использовать Telegram Premium кастомные эмодзи в сообщениях и кнопках.
# Значения: true (по умолчанию) / false (только стандартные Unicode-эмодзи)
CUSTOM_EMOJI=true


# -----------------------------------------------------------------------------
# 2. SOULSEEK P2P (Основной источник музыки FLAC / MP3)
# -----------------------------------------------------------------------------
# Встроенный Soulseek клиент (работает прямо в приложении, Docker не нужен):
# Зарегистрировать бесплатный аккаунт можно в официальном клиенте SoulseekQt или Nicotine+
SLSK_USER=your_slsk_username
SLSK_PASS=your_slsk_password

# Опционально: внешний сервер slskd (для обратной совместимости, если используете slskd)
# SLSKD_URL=http://localhost:5030
# SLSKD_USER=username
# SLSKD_PASS=password
# SLSKD_DOWNLOADS_PATH=C:/path/to/slskd/downloads


# -----------------------------------------------------------------------------
# 3. TELEGRAM BOT API SERVER (Файлы до 2 ГБ вместо лимита 50 МБ)
# -----------------------------------------------------------------------------
# Стандартный облачный Telegram Bot API ограничен загрузкой файлов до 50 МБ.
# Для отправки треков/альбомов в высоком качестве (FLAC) до 2 ГБ используется
# локальный Telegram Bot API Server.

# ВАРИАНТ А: Вы поднимаете Docker-контейнер самостоятельно (РЕКОМЕНДУЕТСЯ):
# Команда для запуска Docker (замените YOUR_ID и YOUR_HASH с https://my.telegram.org):
# docker run -d --name telegram-bot-api -p 8081:8081 -v ./downloads/bot_api_data:/var/lib/telegram-bot-api aiogram/telegram-bot-api:latest --api-id=YOUR_ID --api-hash=YOUR_HASH --local
#
# Затем просто укажите URL работающего контейнера:
BOT_API_SERVER_URL=http://localhost:8081

# ВАРИАНТ Б: Бот сам запускает локальный бинарный файл telegram-bot-api (.exe / ELF):
# LOCAL_BOT_API=true
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# BOT_API_PORT=8081
# BOT_API_DATA_DIR=./downloads/bot_api_data
# Опциональный путь к бинарнику (если не лежит в bin/ или PATH):
# TELEGRAM_BOT_API_BIN=C:/path/to/telegram-bot-api.exe


# -----------------------------------------------------------------------------
# 4. МЕТАДАННЫЕ И ТЕГИ (Опционально)
# -----------------------------------------------------------------------------
# Last.fm API Key (для жанров и тегов; по умолчанию используется встроенный ключ)
LASTFM_API_KEY=your_lastfm_api_key

# Discogs Personal Access Token (для обложек высокого разрешения и годов релиза)
# Получить: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your_discogs_personal_access_token

# Songlink / Odesli API Key (если нет ключа, автоматически работает веб-парсер)
SONGLINK_API_KEY=your_odesli_api_key


# -----------------------------------------------------------------------------
# 5. ДИРЕКТОРИИ И ХРАНИЛИЩЕ (Опционально)
# -----------------------------------------------------------------------------
# Папка для сохранения скачанных треков (по умолчанию ./downloads)
DOWNLOAD_DIR=./downloads

# Временная папка для загрузок бота (автоматически очищается после отправки)
BOT_TEMP_DIR=./downloads/temp_bot
