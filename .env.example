# Настройки встроенного Soulseek P2P (работает прямо в приложении, Docker/slskd не нужны)
# SLSK_USER=your_slsk_username
# SLSK_PASS=your_slsk_password
#
# Опционально: внешний slskd (для обратной совместимости)
# SLSKD_URL=http://localhost:5030
# SLSKD_USER=username
# SLSKD_PASS=password
# SLSKD_DOWNLOADS_PATH=C:/path/to/slskd/downloads


# Настройки Last.fm (для получения жанров/тегов, по умолчанию используется встроенный ключ)
# LASTFM_API_KEY=your_lastfm_api_key

# Настройки Discogs (для получения обложек, жанров и годов)
# DISCOGS_TOKEN=your_discogs_personal_access_token

# Опциональный ключ Songlink/Odesli API (если нет ключа, автоматически используется веб-парсер без ограничений)
# SONGLINK_API_KEY=your_odesli_api_key

# Путь для сохранения скачанных треков
# DOWNLOAD_DIR=./downloads

# Настройки Telegram-бота (интерфейс бота: uv run python bot.py)
# BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Белый список Telegram ID через запятую (узнать ID можно командой /id или в боте)
# ALLOWED_USERS=123456789,987654321
# Настройки локального Telegram Bot API Server для отправки файлов до 2 ГБ (вместо лимита 50 МБ)
# Автоматическое управление сервером (встроенное поднятие при запуске бота через binary или Docker):
# LOCAL_BOT_API=true
# Telegram API ID и API Hash (получить можно на https://my.telegram.org)
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
# Порт локального Bot API сервера (по умолчанию 8081)
# BOT_API_PORT=8081
# Директория данных локального Bot API сервера (по умолчанию ./downloads/bot_api_data)
# BOT_API_DATA_DIR=./downloads/bot_api_data
# Опциональный путь к бинарному файлу telegram-bot-api (если не в bin/ или PATH)
# TELEGRAM_BOT_API_BIN=C:/path/to/telegram-bot-api.exe
# Опционально: URL уже запущенного внешнего сервера Bot API
# BOT_API_SERVER_URL=http://localhost:8081
# Временная папка для загрузок бота (автоматически очищается)
# BOT_TEMP_DIR=./downloads/temp_bot

